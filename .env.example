# RankMap — Environment Variable Template
# Copy this file to .env and fill in real values for local development.
# NEVER commit .env. This file (.env.example) must contain fake placeholders only.

# ============================================================
# CORE
# ============================================================

NODE_ENV=development

# Set automatically by Replit — override locally if needed
PORT=3000

# Public URL used for Stripe success/cancel and billing portal redirects
APP_URL=http://localhost:3000

# PostgreSQL — set automatically by Replit database provisioning
DATABASE_URL=postgresql://fakeuser:fakepassword@localhost:5432/rankmap_dev

# Session secret — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# Optional: API server serves the built frontend from this directory in hosted staging/production
STATIC_ASSETS_DIR=

# ============================================================
# FEATURE FLAGS (default: false — mock adapters used)
# ============================================================

FEATURE_AI_CLUSTERING=false
FEATURE_BILLING=false
FEATURE_STRIPE_BILLING=false
FEATURE_AHREFS_IMPORT=false
FEATURE_SEMRUSH_IMPORT=false
FEATURE_DATAFORSEO_IMPORT=false
FEATURE_WHITE_LABEL=false

# ============================================================
# GEO/AEO AUDIT (manual/mock first)
# ============================================================

GEO_AEO_ENABLED=true
MOCK_ANSWER_ENGINE_ENABLED=true
REAL_ANSWER_ENGINE_CALLS_ENABLED=false
MANUAL_GEO_AEO_SNAPSHOTS_ENABLED=true
GOOGLE_AI_OVERVIEWS_MANUAL_ONLY=true
PERPLEXITY_ENABLED=false
PERPLEXITY_API_KEY=
GEMINI_VISIBILITY_ENABLED=false
CHATGPT_VISIBILITY_MANUAL_ONLY=true
AI_VISIBILITY_MONTHLY_MONITORING_ENABLED=false

# ============================================================
# AI PROVIDERS (Phase 5+) — leave blank unless feature enabled
# ============================================================

OPENAI_API_KEY=replace-with-openai-key
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=replace-with-anthropic-key

# ============================================================
# STRIPE (Phase 10+) — leave blank unless feature enabled
# ============================================================

STRIPE_SECRET_KEY=replace-with-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=replace-with-stripe-publishable-key
# Configure the Stripe endpoint to POST to APP_URL/api/billing/webhook.
STRIPE_WEBHOOK_SECRET=replace-with-stripe-webhook-secret
STRIPE_PRICE_SOLO=price_fake_solo
STRIPE_PRICE_AGENCY=price_fake_agency
STRIPE_PRICE_ENTERPRISE=price_fake_enterprise

# ============================================================
# INTEGRATIONS (Phase 11+) — leave blank unless feature enabled
# ============================================================

AHREFS_API_KEY=fake-ahrefs-api-key-placeholder
SEMRUSH_API_KEY=fake-semrush-api-key-placeholder
DATAFORSEO_LOGIN=fake-dataforseo-login
DATAFORSEO_PASSWORD=fake-dataforseo-password

# ============================================================
# EMAIL
# ============================================================

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# ============================================================
# LIVE DIAGNOSTICS
# ============================================================

LIVE_KEYWORD_PROVIDER_CHECKS=false
PREFLIGHT_HEALTH_URL=
PREFLIGHT_SKIP_MIGRATIONS=false
PREFLIGHT_SKIP_LIVE_SERVICES=false
