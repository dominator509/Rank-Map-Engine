# RankMap — Environment Variable Template
# Copy this file to .env and fill in real values for local development.
# NEVER commit .env. This file (.env.example) must contain fake placeholders only.

# ============================================================
# CORE
# ============================================================

NODE_ENV=development

# Set automatically by Replit — override locally if needed
PORT=3000

# PostgreSQL — set automatically by Replit database provisioning
DATABASE_URL=postgresql://fakeuser:fakepassword@localhost:5432/rankmap_dev

# Session secret — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# ============================================================
# FEATURE FLAGS (default: false — mock adapters used)
# ============================================================

FEATURE_AI_CLUSTERING=false
FEATURE_STRIPE_BILLING=false
FEATURE_AHREFS_IMPORT=false
FEATURE_SEMRUSH_IMPORT=false
FEATURE_SEORX_INTEGRATION=false
FEATURE_WHITE_LABEL=false

# ============================================================
# AI PROVIDERS (Phase 5+) — leave blank unless feature enabled
# ============================================================

OPENAI_API_KEY=sk-fakeopenaikeyplaceholderdonotuse
ANTHROPIC_API_KEY=sk-ant-fakeanthropickeyplaceholderdonotuse

# ============================================================
# STRIPE (Phase 10+) — leave blank unless feature enabled
# ============================================================

STRIPE_SECRET_KEY=sk_test_fakestripesecretkeyplaceholder
STRIPE_PUBLISHABLE_KEY=pk_test_fakestripepublishablekeyplaceholder
STRIPE_WEBHOOK_SECRET=whsec_fakewebhooksecretplaceholder

# ============================================================
# INTEGRATIONS (Phase 11+) — leave blank unless feature enabled
# ============================================================

AHREFS_API_KEY=fake-ahrefs-api-key-placeholder
SEMRUSH_API_KEY=fake-semrush-api-key-placeholder
