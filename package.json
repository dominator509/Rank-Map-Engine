{
  "name": "workspace",
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "preinstall": "node ./scripts/ensure-pnpm.mjs",
    "build": "corepack pnpm run typecheck && corepack pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "corepack pnpm run typecheck:libs && corepack pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\" --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css}\" --ignore-path .prettierignore",
    "test": "vitest run",
    "test:e2e:api": "node ./scripts/run-api-e2e.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "private": true,
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@typescript-eslint/eslint-plugin": "^8.32.1",
    "@typescript-eslint/parser": "^8.32.1",
    "@vitest/coverage-v8": "^3.1.3",
    "eslint": "^9.27.0",
    "globals": "^16.1.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^3.1.3"
  }
}
